# Smart Fabric Recommendation System - Environment Variables
# Copy this file to .env and insert your real keys if available

# Optional: Google Gemini API Key for enhanced generative natural language explanations
# The application functions 100% offline with full rule-based explainability if this key is omitted.
GEMINI_API_KEY=your_gemini_api_key_here

# Database file path (default is database/fabrics_feedback.db)
DATABASE_PATH=database/fabrics_feedback.db
